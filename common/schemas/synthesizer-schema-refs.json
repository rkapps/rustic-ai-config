{
  "required": ["title", "sections"],
  "properties": {
    "title": {
      "description": "Short report title. Used as the document heading and the file name.",
      "type": "string"
    },
    "sections": {
      "description": "Sections in display order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Section"
      }
    }
  },
  "description": "A complete report: a title plus an ordered list of sections.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Section": {
      "description": "One block of the report. `type` selects which content fields apply.",
      "anyOf": [
        {
          "description": "A short narrative paragraph. Supports **bold** markup only.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["context"]
            },
            "title": {
              "description": "Section heading.",
              "type": "string"
            },
            "group": {
              "description": "Optional grouping key used by the UI (e.g. tabs or anchors), such as\n\"overview\", \"fundamentals\" or \"risk\".",
              "type": ["string", "null"]
            },
            "content": {
              "type": "string"
            }
          },
          "required": ["type", "title", "group", "content"],
          "additionalProperties": false
        },
        {
          "description": "A row of headline numbers.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["metric_cards"]
            },
            "title": {
              "description": "Section heading.",
              "type": "string"
            },
            "group": {
              "description": "Optional grouping key used by the UI (e.g. tabs or anchors), such as\n\"overview\", \"fundamentals\" or \"risk\".",
              "type": ["string", "null"]
            },
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MetricCard"
              }
            }
          },
          "required": ["type", "title", "group", "data"],
          "additionalProperties": false
        },
        {
          "description": "A table. Every row must have exactly `headers.len()` cells; the first\ncell of every row is its label.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["table"]
            },
            "title": {
              "description": "Section heading.",
              "type": "string"
            },
            "group": {
              "description": "Optional grouping key used by the UI (e.g. tabs or anchors), such as\n\"overview\", \"fundamentals\" or \"risk\".",
              "type": ["string", "null"]
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Cell"
                }
              }
            },
            "totals": {
              "description": "Optional summary rows shown below the body, e.g. totals or averages.\nSame shape as `rows`. Empty when there is no meaningful aggregate.",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Cell"
                }
              }
            }
          },
          "required": ["type", "title", "group", "headers", "rows", "totals"],
          "additionalProperties": false
        },
        {
          "description": "Values per named row and series. Rendered as a chart on screen and as a\ntable with data bars in documents.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["bar_chart"]
            },
            "title": {
              "description": "Section heading.",
              "type": "string"
            },
            "group": {
              "description": "Optional grouping key used by the UI (e.g. tabs or anchors), such as\n\"overview\", \"fundamentals\" or \"risk\".",
              "type": ["string", "null"]
            },
            "series": {
              "description": "Series names, one per value in each row. May be empty when every row\nhas exactly one value.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "format": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Format"
                },
                {
                  "type": "null"
                }
              ]
            },
            "orientation": {
              "$ref": "#/$defs/Orientation"
            },
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BarRow"
              }
            }
          },
          "required": ["type", "title", "group", "series", "format", "orientation", "data"],
          "additionalProperties": false
        },
        {
          "description": "A trend over time: one line per series, each with one value per `x`\nlabel. Use null for a missing point; the line breaks there.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["line_chart"]
            },
            "title": {
              "description": "Section heading.",
              "type": "string"
            },
            "group": {
              "description": "Optional grouping key used by the UI (e.g. tabs or anchors), such as\n\"overview\", \"fundamentals\" or \"risk\".",
              "type": ["string", "null"]
            },
            "x": {
              "description": "Labels along the horizontal axis, in order (dates, months, quarters).",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "format": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Format"
                },
                {
                  "type": "null"
                }
              ]
            },
            "series": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LineSeries"
              }
            }
          },
          "required": ["type", "title", "group", "x", "format", "series"],
          "additionalProperties": false
        },
        {
          "description": "Current value against a target, per subject (price targets, sales\nagainst quota, spend against budget). The change to target is computed\nby the renderer; do not supply it.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["targets"]
            },
            "title": {
              "description": "Section heading.",
              "type": "string"
            },
            "group": {
              "description": "Optional grouping key used by the UI (e.g. tabs or anchors), such as\n\"overview\", \"fundamentals\" or \"risk\".",
              "type": ["string", "null"]
            },
            "format": {
              "description": "Format of `current` and `target` (e.g. currency).",
              "anyOf": [
                {
                  "$ref": "#/$defs/Format"
                },
                {
                  "type": "null"
                }
              ]
            },
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Target"
              }
            }
          },
          "required": ["type", "title", "group", "format", "data"],
          "additionalProperties": false
        },
        {
          "description": "One card per subject with short labelled values (positioning,\nscorecards, vendor comparisons).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["profiles"]
            },
            "title": {
              "description": "Section heading.",
              "type": "string"
            },
            "group": {
              "description": "Optional grouping key used by the UI (e.g. tabs or anchors), such as\n\"overview\", \"fundamentals\" or \"risk\".",
              "type": ["string", "null"]
            },
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Profile"
              }
            }
          },
          "required": ["type", "title", "group", "data"],
          "additionalProperties": false
        },
        {
          "description": "Scores by source (reviews, surveys, satisfaction).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ratings"]
            },
            "title": {
              "description": "Section heading.",
              "type": "string"
            },
            "group": {
              "description": "Optional grouping key used by the UI (e.g. tabs or anchors), such as\n\"overview\", \"fundamentals\" or \"risk\".",
              "type": ["string", "null"]
            },
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Rating"
              }
            },
            "related": {
              "description": "Related topics or searches, shown as a short list. May be empty.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["type", "title", "group", "data", "related"],
          "additionalProperties": false
        },
        {
          "description": "Numbered findings with supporting evidence.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["insight_cards"]
            },
            "title": {
              "description": "Section heading.",
              "type": "string"
            },
            "group": {
              "description": "Optional grouping key used by the UI (e.g. tabs or anchors), such as\n\"overview\", \"fundamentals\" or \"risk\".",
              "type": ["string", "null"]
            },
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Insight"
              }
            }
          },
          "required": ["type", "title", "group", "data"],
          "additionalProperties": false
        },
        {
          "description": "Follow-up questions for the user. Interactive only; documents skip them.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["suggested_prompts"]
            },
            "title": {
              "description": "Section heading.",
              "type": "string"
            },
            "group": {
              "description": "Optional grouping key used by the UI (e.g. tabs or anchors), such as\n\"overview\", \"fundamentals\" or \"risk\".",
              "type": ["string", "null"]
            },
            "prompts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["type", "title", "group", "prompts"],
          "additionalProperties": false
        }
      ]
    },
    "MetricCard": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/CellValue"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/Format"
            },
            {
              "type": "null"
            }
          ]
        },
        "change": {
          "description": "Change as a number, formatted with `change_format` (default: percent change).",
          "type": ["number", "null"]
        },
        "change_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/Format"
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Signal"
            },
            {
              "type": "null"
            }
          ]
        },
        "benchmark": {
          "description": "Comparison text, e.g. \"$114.47 target\" or \"vs BA 833x\".",
          "type": ["string", "null"]
        }
      },
      "required": ["label", "value", "format", "change", "change_format", "signal", "benchmark"],
      "additionalProperties": false
    },
    "CellValue": {
      "description": "A cell value: a raw number (formatted by the renderer) or text.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "Format": {
      "description": "How a number is displayed. Percent values are in percentage points:\n7.83 means 7.83%, not 783%.",
      "anyOf": [
        {
          "description": "Plain number, up to 3 decimals.",
          "type": "string",
          "enum": ["number"]
        },
        {
          "description": "Whole number with thousands separators.",
          "type": "string",
          "enum": ["integer"]
        },
        {
          "description": "Money, 2 decimals, with the currency symbol.",
          "type": "string",
          "enum": ["currency"]
        },
        {
          "description": "A level, e.g. a rate of 4.1%.",
          "type": "string",
          "enum": ["percent"]
        },
        {
          "description": "A change, always signed, e.g. +7.83% or -2.4%.",
          "type": "string",
          "enum": ["percent_change"]
        },
        {
          "description": "A multiple, e.g. a P/E of 19.16x.",
          "type": "string",
          "enum": ["multiple"]
        }
      ]
    },
    "Signal": {
      "description": "Direction or sentiment of a value.",
      "type": "string",
      "enum": ["up", "down", "neutral"]
    },
    "Cell": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/CellValue"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/Format"
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Signal"
            },
            {
              "type": "null"
            }
          ]
        },
        "indicator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Indicator"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "description": "Short annotation shown under or beside the value.",
          "type": ["string", "null"]
        }
      },
      "required": ["value", "format", "signal", "indicator", "note"],
      "additionalProperties": false
    },
    "Indicator": {
      "description": "How a signal is drawn next to a value.",
      "type": "string",
      "enum": ["dot", "badge", "arrow"]
    },
    "Orientation": {
      "type": "string",
      "enum": ["horizontal", "vertical"]
    },
    "BarRow": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": ["name", "values"],
      "additionalProperties": false
    },
    "LineSeries": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "values": {
          "description": "One value per `x` label; null where there is no data.",
          "type": "array",
          "items": {
            "type": ["number", "null"]
          }
        }
      },
      "required": ["name", "values"],
      "additionalProperties": false
    },
    "Target": {
      "type": "object",
      "properties": {
        "subject": {
          "description": "What is measured, e.g. \"NVDA\" or \"West region\".",
          "type": "string"
        },
        "current": {
          "type": "number"
        },
        "target": {
          "type": "number"
        },
        "label": {
          "description": "Short qualifier, e.g. \"Buy\" or \"Q4 quota\".",
          "type": ["string", "null"]
        }
      },
      "required": ["subject", "current", "target", "label"],
      "additionalProperties": false
    },
    "Profile": {
      "type": "object",
      "properties": {
        "subject": {
          "description": "The subject of the card, e.g. \"NVDA\".",
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProfileItem"
          }
        }
      },
      "required": ["subject", "items"],
      "additionalProperties": false
    },
    "ProfileItem": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Theme, e.g. \"Valuation\" or \"Risk\".",
          "type": "string"
        },
        "value": {
          "description": "Keywords with the actual figure, at most 30 characters,\ne.g. \"24.88x fwd P/E\" or \"Beta 2.45, high vol\".",
          "type": "string"
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Signal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["label", "value", "signal"],
      "additionalProperties": false
    },
    "Rating": {
      "type": "object",
      "properties": {
        "source": {
          "description": "Where the score comes from, e.g. \"Yelp\" or \"Customer survey\".",
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "max_rating": {
          "type": "number"
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Signal"
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "description": "The main theme behind the score, e.g. \"Mixed delivery complaints\".",
          "type": ["string", "null"]
        }
      },
      "required": ["source", "rating", "max_rating", "signal", "theme"],
      "additionalProperties": false
    },
    "Insight": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "evidence": {
          "description": "Supporting evidence. Supports **bold** markup only.",
          "type": "string"
        },
        "source": {
          "description": "Where the evidence comes from.",
          "type": ["string", "null"]
        }
      },
      "required": ["title", "evidence", "source"],
      "additionalProperties": false
    }
  }
}
